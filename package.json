{
  "name": "codebase-1",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "generate:api-types": "openapi-typescript ../docs/trigger-dev-docs/v3-openapi.yaml -o ./services/api/generated-types.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write '**/*.{ts,tsx,js,json,css,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,json,css,md}'",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "knip": "knip",
    "build:ios": "eas build --platform ios --local",
    "build:android": "eas build --platform android --local",
    "build:all": "eas build --platform all --local"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|nativewind|@rn-primitives/.*|msw|until-async|@bundled-es-modules|@mswjs)"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^msw/node$": "<rootDir>/node_modules/msw/lib/node/index.js",
      "^msw$": "<rootDir>/node_modules/msw/lib/core/index.js"
    }
  },
  "dependencies": {
    "@lodev09/react-native-true-sheet": "^3.9.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@rn-primitives/accordion": "^1.2.0",
    "@rn-primitives/checkbox": "^1.2.0",
    "@rn-primitives/collapsible": "^1.2.0",
    "@rn-primitives/dropdown-menu": "^1.2.0",
    "@rn-primitives/label": "^1.2.0",
    "@rn-primitives/portal": "^1.3.0",
    "@rn-primitives/progress": "^1.2.0",
    "@rn-primitives/select": "^1.2.0",
    "@rn-primitives/slot": "^1.2.0",
    "@rn-primitives/switch": "^1.2.0",
    "@rn-primitives/tabs": "^1.2.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "^55.0.0",
    "expo-application": "~55.0.8",
    "expo-clipboard": "~55.0.8",
    "expo-constants": "~55.0.7",
    "expo-device": "~55.0.9",
    "expo-file-system": "~55.0.10",
    "expo-glass-effect": "~55.0.7",
    "expo-haptics": "~55.0.8",
    "expo-linking": "~55.0.7",
    "expo-local-authentication": "~55.0.8",
    "expo-localization": "~55.0.8",
    "expo-notifications": "~55.0.11",
    "expo-router": "~55.0.4",
    "expo-screen-orientation": "^55.0.8",
    "expo-secure-store": "~55.0.8",
    "expo-system-ui": "~55.0.9",
    "lucide-react-native": "^0.564.0",
    "nativewind": "^4",
    "openapi-fetch": "^0.17.0",
    "posthog-react-native": "^4.37.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^4.2.0",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^25.3.2",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "babel-preset-expo": "~55.0.8",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.9",
    "knip": "^5.85.0",
    "msw": "^2.12.10",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-dom": "19.2.0"
  },
  "private": true
}
