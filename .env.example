# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will not be committed

# --- App Identifiers ---
# These are required for building native apps
IOS_BUNDLE_IDENTIFIER=com.example.triggergo
APPLE_TEAM_ID=
ANDROID_PACKAGE=com.example.triggergo

# Optional: customize app name/slug/scheme
# EXPO_PUBLIC_APP_NAME=TriggerGo
# EXPO_PUBLIC_APP_SLUG=trigger-go
# EXPO_PUBLIC_APP_SCHEME=triggergo

# --- EAS ---
EXPO_OWNER=
EAS_PROJECT_ID=

# --- API ---
# Default Trigger.dev API base URL (override for self-hosted instances)
# EXPO_PUBLIC_API_BASE_URL=https://api.trigger.dev

# --- Sentry (optional) ---
SENTRY_AUTH_TOKEN=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_PROJECT=
SENTRY_ORG=

# --- PostHog (optional) ---
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
